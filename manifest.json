{
  "manifest_version": 3,
  "name": "auto-fill-extension",
  "version": "1.3",
  "description": "Auto fill form and session bridge for Build Approval System & Mobile R&D Hub",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://buildapprovalsystem.com/*",
    "https://*.mobilerndhub.sec.samsung.net/*",
    "https://mobilerndhub.sec.samsung.net/*",
    "https://*.samsung.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://gba.endrisusanto.my.id/*",
    "https://heist.endrisusanto.my.id/*",
    "http://107.102.39.55/*",
    "http://107.102.39.55:*/*",
    "https://107.102.39.55/*",
    "https://107.102.39.55:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://buildapprovalsystem.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
